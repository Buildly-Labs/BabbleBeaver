CORS_ALLOWED_DOMAINS=example.com,anotherdomain.com
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_AUTH_TOKEN=
INITIAL_PROMPT_FILE_PATH=""

# Database Configuration
# Leave empty for SQLite (development) or set PostgreSQL connection string (production)
# Examples:
# DigitalOcean: postgresql://user:pass@host.db.ondigitalocean.com:25060/babblebeaver?sslmode=require
# Google Cloud SQL: postgresql://user:pass@localhost:5432/babblebeaver
DATABASE_URL=

# DigitalOcean Gradient AI Platform
DIGITALOCEAN_AGENT_ENABLED=false
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_AGENT_URL=

INITIAL_PROMPT_FILE_PATH="initial-prompt.txt"
PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"

# Bring-your-own-token (BYOT) custom endpoints: any OpenAI-compatible API,
# including local runtimes (Ollama, vLLM, LM Studio) or a self-hosted/
# third-party OpenAI-compatible service. Register one or more by name:
# CUSTOM_ENDPOINTS=mylocal
# CUSTOM_MYLOCAL_BASE_URL=http://localhost:11434/v1
# CUSTOM_MYLOCAL_MODEL=llama3.1
# CUSTOM_MYLOCAL_API_KEY=ollama
# CUSTOM_MYLOCAL_PRIORITY=0
# CUSTOM_MYLOCAL_ENABLED=true
CUSTOM_ENDPOINTS=

# Task-based routing: which provider(s) should handle each kind of task.
# Value is a comma-separated ordered list of provider names (a built-in
# provider's type name, e.g. "openai"/"gemini"/"digitalocean", or a
# CUSTOM_ENDPOINTS name above). Leave unset to use normal priority fallback.
# ROUTE_CHAT=openai,digitalocean
# ROUTE_CODE=mylocal,openai
# ROUTE_SUMMARIZE=digitalocean
# ROUTE_EXTRACT=digitalocean
# ROUTE_REASON=openai

# Require a bearer token on /chatbot (see SECURITY.md). Defaults to false
# for backward compatibility - set true once your client sends a token.
REQUIRE_CHATBOT_AUTH=false
